# ============================================================================
# ASCENDIX — CONSOLIDATED ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# ============================================================================
# Inferred directly from gateway/src/*, backend/ascendix_core/settings.py,
# backend/core/db.py, backend/core/authentication.py, and frontend/src/services/api.js.
# All sensitive values have been replaced with [REDACTED] placeholders.

# ----------------------------------------------------------------------------
# 1. Express.js API Gateway Service (gateway/.env)
# ----------------------------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ascendix_db
JWT_SECRET=[REDACTED]
DJANGO_URL=http://127.0.0.1:8000
GATEWAY_SECRET=[REDACTED]
ADMIN_EMAIL=admin@ascendix.edu
ADMIN_PASSWORD=[REDACTED]

# ----------------------------------------------------------------------------
# 2. Django REST Framework Domain Engine (backend/.env)
# ----------------------------------------------------------------------------
DJANGO_SECRET_KEY=[REDACTED]
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# PORT=8000
# MONGODB_URI=mongodb://127.0.0.1:27017/ascendix_db
# GATEWAY_SECRET=[REDACTED]

# ----------------------------------------------------------------------------
# 3. React + Vite Frontend SPA (frontend/.env - Optional Override)
# ----------------------------------------------------------------------------
VITE_API_URL=/api
